import pandas as pd  
# Read the CSV file  
file_name = "data.csv" # Replace with your CSV file name  
data = pd.read_csv(file_name)  
# Display the first 5 rows  
print("First 5 rows of the dataset:")  
print(data.head())  
# Mean  
print("\nMean of numerical columns:")  
print(data.mean(numeric_only=True))  
# Median  
print("\nMedian of numerical columns:")  
print(data.median(numeric_only=True))  
# Mode  
print("\nMode of numerical columns:")  
print(data.mode(numeric_only=True).iloc[0])
